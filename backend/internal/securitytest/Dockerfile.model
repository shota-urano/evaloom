# Test-only CLIs. Versions must be selected explicitly when building.
FROM node:22-bookworm-slim
ARG CODEX_VERSION
ARG CLAUDE_VERSION
RUN test -n "$CODEX_VERSION" && test -n "$CLAUDE_VERSION" \
    && apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates \
    && npm install --global "@openai/codex@${CODEX_VERSION}" "@anthropic-ai/claude-code@${CLAUDE_VERSION}" \
    && rm -rf /var/lib/apt/lists/*
