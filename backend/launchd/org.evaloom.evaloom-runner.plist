<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.evaloom.evaloom-runner</string>
    <key>ProgramArguments</key>
    <array>
        <string>__EVALOOM_ROOT__/data/bin/evaloom-runner</string>
        <string>-config</string>
        <string>__EVALOOM_ROOT__/data/runner.json</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__EVALOOM_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__EVALOOM_ROOT__/data/logs/evaloom-runner.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__EVALOOM_ROOT__/data/logs/evaloom-runner.stderr.log</string>
</dict>
</plist>
