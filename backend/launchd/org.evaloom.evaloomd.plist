<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.evaloom.evaloomd</string>
    <key>ProgramArguments</key>
    <array>
        <string>__EVALOOM_ROOT__/data/bin/evaloomd</string>
        <string>-db</string>
        <string>__EVALOOM_ROOT__/data/evaloom.db</string>
        <string>-port</string>
        <string>8080</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__EVALOOM_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__EVALOOM_ROOT__/data/logs/evaloomd.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>__EVALOOM_ROOT__/data/logs/evaloomd.stderr.log</string>
</dict>
</plist>
